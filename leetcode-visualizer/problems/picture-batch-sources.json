  "261": [
    "class Solution:",
    "",
    "    def validTree(self, n, edges):",
    "        if len(edges) != n - 1:",
    "            return False",
    "        parent = list(range(n))",
    "",
    "        def find(node):",
    "            while parent[node] != node:",
    "                parent[node] = parent[parent[node]]",
    "                node = parent[node]",
    "            return node",
    "        for (u, v) in edges:",
    "            (root_u, root_v) = (find(u), find(v))",
    "            if root_u == root_v:",
    "                return False",
    "            parent[root_u] = root_v",
    "        return True"
  ],
  "305": [
    "class Solution:",
    "",
    "    def numIslands2(self, m, n, positions):",
    "        parent = [-1] * (m * n)",
    "        size = [0] * (m * n)",
    "        (answer, islands) = ([], 0)",
    "",
    "        def find(x):",
    "            while parent[x] != x:",
    "                parent[x] = parent[parent[x]]",
    "                x = parent[x]",
    "            return x",
    "",
    "        def union(a, b):",
    "            (ra, rb) = (find(a), find(b))",
    "            if ra == rb:",
    "                return False",
    "            if size[ra] < size[rb]:",
    "                (ra, rb) = (rb, ra)",
    "            parent[rb] = ra",
    "            size[ra] += size[rb]",
    "            return True",
    "        for (row, col) in positions:",
    "            node = row * n + col",
    "            if parent[node] != -1:",
    "                answer.append(islands)",
    "                continue",
    "            parent[node] = node",
    "            size[node] = 1",
    "            islands += 1",
    "            for (dr, dc) in ((1, 0), (-1, 0), (0, 1), (0, -1)):",
    "                (nr, nc) = (row + dr, col + dc)",
    "                if 0 <= nr < m and 0 <= nc < n and (parent[nr * n + nc] != -1):",
    "                    if union(node, nr * n + nc):",
    "                        islands -= 1",
    "            answer.append(islands)",
    "        return answer"
  ],
  "310": [
    "class Solution:",
    "",
    "    def findMinHeightTrees(self, n, edges):",
    "        if n <= 2:",
    "            return list(range(n))",
    "        graph = [[] for _ in range(n)]",
    "        for (a, b) in edges:",
    "            graph[a].append(b)",
    "            graph[b].append(a)",
    "        leaves = [i for i in range(n) if len(graph[i]) == 1]",
    "        remaining = n",
    "        while remaining > 2:",
    "            remaining -= len(leaves)",
    "            next_leaves = []",
    "            for leaf in leaves:",
    "                neighbor = graph[leaf].pop()",
    "                graph[neighbor].remove(leaf)",
    "                if len(graph[neighbor]) == 1:",
    "                    next_leaves.append(neighbor)",
    "            leaves = next_leaves",
    "        return leaves"
  ],
  "407": [
    "import heapq",
    "",
    "class Solution:",
    "",
    "    def trapRainWater(self, heightMap):",
    "        if not heightMap or not heightMap[0]:",
    "            return 0",
    "        (rows, cols) = (len(heightMap), len(heightMap[0]))",
    "        heap = []",
    "        visited = [[False] * cols for _ in range(rows)]",
    "        for r in range(rows):",
    "            for c in range(cols):",
    "                if r == 0 or r == rows - 1 or c == 0 or (c == cols - 1):",
    "                    heapq.heappush(heap, (heightMap[r][c], r, c))",
    "                    visited[r][c] = True",
    "        water = 0",
    "        dirs = [(1, 0), (-1, 0), (0, 1), (0, -1)]",
    "        while heap:",
    "            (height, r, c) = heapq.heappop(heap)",
    "            for (dr, dc) in dirs:",
    "                (nr, nc) = (r + dr, c + dc)",
    "                if nr < 0 or nr >= rows or nc < 0 or (nc >= cols) or visited[nr][nc]:",
    "                    continue",
    "                visited[nr][nc] = True",
    "                trapped = max(0, height - heightMap[nr][nc])",
    "                water += trapped",
    "                new_height = max(height, heightMap[nr][nc])",
    "                heapq.heappush(heap, (new_height, nr, nc))",
    "        return water"
  ],
  "675": [
    "from collections import deque",
    "",
    "class Solution:",
    "",
    "    def cutOffTree(self, forest):",
    "        trees = sorted(((h, r, c) for (r, row) in enumerate(forest) for (c, h) in enumerate(row) if h > 1))",
    "        if not trees:",
    "            return 0",
    "        if forest[0][0] == 0:",
    "            return -1",
    "        sr = 0",
    "        sc = 0",
    "        ans = 0",
    "",
    "        def bfs(tr, tc):",
    "            q = deque([(sr, sc, 0)])",
    "            seen = {(sr, sc)}",
    "            while q:",
    "                (r, c, d) = q.popleft()",
    "                if (r, c) == (tr, tc):",
    "                    return d",
    "                for (dr, dc) in ((1, 0), (-1, 0), (0, 1), (0, -1)):",
    "                    (nr, nc) = (r + dr, c + dc)",
    "                    if 0 <= nr < len(forest) and 0 <= nc < len(forest[0]) and forest[nr][nc] and ((nr, nc) not in seen):",
    "                        seen.add((nr, nc))",
    "                        q.append((nr, nc, d + 1))",
    "            return -1",
    "        for (h, tr, tc) in trees:",
    "            d = bfs(tr, tc)",
    "            if d < 0:",
    "                return -1",
    "            ans += d",
    "            (sr, sc) = (tr, tc)",
    "            forest[tr][tc] = 1",
    "        return ans"
  ],
  "947": [
    "class Solution:",
    "",
    "    def removeStones(self, stones):",
    "        parent = {}",
    "",
    "        def find(x):",
    "            parent.setdefault(x, x)",
    "            if parent[x] != x:",
    "                parent[x] = find(parent[x])",
    "            return parent[x]",
    "",
    "        def union(a, b):",
    "            parent[find(a)] = find(b)",
    "        for (row, col) in stones:",
    "            union(('row', row), ('col', col))",
    "        return len(stones) - len({find(node) for node in parent})"
  ],
  "990": [
    "class Solution:",
    "",
    "    def equationsPossible(self, equations):",
    "        parent = list(range(26))",
    "        size = [1] * 26",
    "",
    "        def find(x):",
    "            while parent[x] != x:",
    "                parent[x] = parent[parent[x]]",
    "                x = parent[x]",
    "            return x",
    "",
    "        def union(a, b):",
    "            (root_a, root_b) = (find(a), find(b))",
    "            if root_a == root_b:",
    "                return",
    "            if size[root_a] < size[root_b]:",
    "                (root_a, root_b) = (root_b, root_a)",
    "            parent[root_b] = root_a",
    "            size[root_a] += size[root_b]",
    "        for equation in equations:",
    "            if equation[1:3] == '==':",
    "                union(ord(equation[0]) - 97, ord(equation[3]) - 97)",
    "        for equation in equations:",
    "            if equation[1:3] == '!=' and find(ord(equation[0]) - 97) == find(ord(equation[3]) - 97):",
    "                return False",
    "        return True"
  ],
  "1284": [
    "from collections import deque",
    "",
    "class Solution:",
    "",
    "    def minFlips(self, mat):",
    "        (m, n) = (len(mat), len(mat[0]))",
    "        flips = []",
    "        for r in range(m):",
    "            for c in range(n):",
    "                flip = 0",
    "                for (dr, dc) in ((0, 0), (1, 0), (-1, 0), (0, 1), (0, -1)):",
    "                    (nr, nc) = (r + dr, c + dc)",
    "                    if 0 <= nr < m and 0 <= nc < n:",
    "                        flip |= 1 << nr * n + nc",
    "                flips.append(flip)",
    "        start = sum((mat[r][c] << r * n + c for r in range(m) for c in range(n)))",
    "        q = deque([(start, 0)])",
    "        seen = {start}",
    "        while q:",
    "            (mask, d) = q.popleft()",
    "            if mask == 0:",
    "                return d",
    "            for (index, flip) in enumerate(flips):",
    "                nxt = mask ^ flip",
    "                if nxt not in seen:",
    "                    seen.add(nxt)",
    "                    q.append((nxt, d + 1))",
    "        return -1"
  ],
  "1466": [
    "class Solution:",
    "",
    "    def minReorder(self, n, connections):",
    "        graph = [[] for _ in range(n)]",
    "        for (a, b) in connections:",
    "            graph[a].append((b, 1))",
    "            graph[b].append((a, 0))",
    "        answer = 0",
    "        stack = [(0, -1)]",
    "        while stack:",
    "            (city, parent) = stack.pop()",
    "            for (nxt, cost) in graph[city]:",
    "                if nxt == parent:",
    "                    continue",
    "                answer += cost",
    "                stack.append((nxt, city))",
    "        return answer"
  ],
  "3310": [
    "from collections import deque",
    "",
    "class Solution:",
    "",
    "    def remainingMethods(self, n, k, invocations):",
    "        adj = [[] for _ in range(n)]",
    "        for (a, b) in invocations:",
    "            adj[a].append(b)",
    "        suspicious = set()",
    "        queue = deque([k])",
    "        suspicious.add(k)",
    "        while queue:",
    "            node = queue.popleft()",
    "            for nxt in adj[node]:",
    "                if nxt not in suspicious:",
    "                    suspicious.add(nxt)",
    "                    queue.append(nxt)",
    "        for (a, b) in invocations:",
    "            if a not in suspicious and b in suspicious:",
    "                return list(range(n))",
    "        return [i for i in range(n) if i not in suspicious]"
  ],
  "4003": [
    "import heapq",
    "",
    "class Solution:",
    "",
    "    def minCost(self, m, n, penalty):",
    "        INF = float('inf')",
    "        dist = [[[INF] * 2 for _ in range(n)] for _ in range(m)]",
    "        dist[0][0][1] = (0 + 1) * (0 + 1)",
    "        heap = [(dist[0][0][1], 0, 0, 1)]",
    "        while heap:",
    "            (cost, r, c, par) = heapq.heappop(heap)",
    "            if cost > dist[r][c][par]:",
    "                continue",
    "            if r == m - 1 and c == n - 1:",
    "                return cost",
    "            for (dr, dc) in [(0, 1), (1, 0), (0, -1), (-1, 0)]:",
    "                (nr, nc) = (r + dr, c + dc)",
    "                if 0 <= nr < m and 0 <= nc < n:",
    "                    follows = par == 1 and dr + dc > 0 or (par == 0 and dr + dc < 0)",
    "                    pen = 0 if follows else penalty[r][c]",
    "                    nc_cost = cost + (nr + 1) * (nc + 1) + pen",
    "                    if nc_cost < dist[nr][nc][1 - par]:",
    "                        dist[nr][nc][1 - par] = nc_cost",
    "                        heapq.heappush(heap, (nc_cost, nr, nc, 1 - par))",
    "            wait_cost = cost + penalty[r][c]",
    "            if wait_cost < dist[r][c][1 - par]:",
    "                dist[r][c][1 - par] = wait_cost",
    "                heapq.heappush(heap, (wait_cost, r, c, 1 - par))",
    "        return min(dist[m - 1][n - 1])"
  ],
  "529": [
    "from collections import deque",
    "",
    "class Solution:",
    "",
    "    def updateBoard(self, board, click):",
    "        (rows, cols) = (len(board), len(board[0]))",
    "        (r, c) = click",
    "        if board[r][c] == 'M':",
    "            board[r][c] = 'X'",
    "            return board",
    "        if board[r][c] != 'E':",
    "            return board",
    "        directions = [(dr, dc) for dr in (-1, 0, 1) for dc in (-1, 0, 1) if dr or dc]",
    "        queued = [[False] * cols for _ in range(rows)]",
    "        q = deque([(r, c)])",
    "        queued[r][c] = True",
    "        while q:",
    "            (r, c) = q.popleft()",
    "            mines = 0",
    "            for (dr, dc) in directions:",
    "                (nr, nc) = (r + dr, c + dc)",
    "                if 0 <= nr < rows and 0 <= nc < cols and (board[nr][nc] == 'M'):",
    "                    mines += 1",
    "            if mines:",
    "                board[r][c] = str(mines)",
    "                continue",
    "            board[r][c] = 'B'",
    "            for (dr, dc) in directions:",
    "                (nr, nc) = (r + dr, c + dc)",
    "                if 0 <= nr < rows and 0 <= nc < cols and (board[nr][nc] == 'E') and (not queued[nr][nc]):",
    "                    queued[nr][nc] = True",
    "                    q.append((nr, nc))",
    "        return board"
  ],
  "1034": [
    "from collections import deque",
    "",
    "class Solution:",
    "",
    "    def colorBorder(self, grid, row, col, color):",
    "        (rows, cols) = (len(grid), len(grid[0]))",
    "        old = grid[row][col]",
    "        seen = [[False] * cols for _ in range(rows)]",
    "        q = deque([(row, col)])",
    "        seen[row][col] = True",
    "        border = []",
    "        while q:",
    "            (r, c) = q.popleft()",
    "            is_border = False",
    "            for (dr, dc) in ((1, 0), (-1, 0), (0, 1), (0, -1)):",
    "                (nr, nc) = (r + dr, c + dc)",
    "                if nr < 0 or nr >= rows or nc < 0 or (nc >= cols) or (grid[nr][nc] != old):",
    "                    is_border = True",
    "                elif not seen[nr][nc]:",
    "                    seen[nr][nc] = True",
    "                    q.append((nr, nc))",
    "            if is_border:",
    "                border.append((r, c))",
    "        for (r, c) in border:",
    "            grid[r][c] = color",
    "        return grid"
  ],
  "1992": [
    "from collections import deque",
    "",
    "class Solution:",
    "",
    "    def findFarmland(self, land):",
    "        (rows, cols) = (len(land), len(land[0]))",
    "        seen = [[False] * cols for _ in range(rows)]",
    "        answer = []",
    "        for r in range(rows):",
    "            for c in range(cols):",
    "                if not land[r][c] or seen[r][c]:",
    "                    continue",
    "                q = deque([(r, c)])",
    "                seen[r][c] = True",
    "                (top, left, bottom, right) = (r, c, r, c)",
    "                while q:",
    "                    (x, y) = q.popleft()",
    "                    top = min(top, x)",
    "                    left = min(left, y)",
    "                    bottom = max(bottom, x)",
    "                    right = max(right, y)",
    "                    for (dr, dc) in ((1, 0), (-1, 0), (0, 1), (0, -1)):",
    "                        (nr, nc) = (x + dr, y + dc)",
    "                        if 0 <= nr < rows and 0 <= nc < cols and land[nr][nc] and (not seen[nr][nc]):",
    "                            seen[nr][nc] = True",
    "                            q.append((nr, nc))",
    "                answer.append([top, left, bottom, right])",
    "        return answer"
  ],
  "2658": [
    "from collections import deque",
    "",
    "class Solution:",
    "",
    "    def findMaxFish(self, grid):",
    "        (rows, cols) = (len(grid), len(grid[0]))",
    "        seen = [[False] * cols for _ in range(rows)]",
    "        best = 0",
    "        for r in range(rows):",
    "            for c in range(cols):",
    "                if grid[r][c] == 0 or seen[r][c]:",
    "                    continue",
    "                q = deque([(r, c)])",
    "                seen[r][c] = True",
    "                fish = 0",
    "                while q:",
    "                    (x, y) = q.popleft()",
    "                    fish += grid[x][y]",
    "                    for (dr, dc) in ((1, 0), (-1, 0), (0, 1), (0, -1)):",
    "                        (nr, nc) = (x + dr, y + dc)",
    "                        if 0 <= nr < rows and 0 <= nc < cols and (grid[nr][nc] > 0) and (not seen[nr][nc]):",
    "                            seen[nr][nc] = True",
    "                            q.append((nr, nc))",
    "                best = max(best, fish)",
    "        return best"
  ],
  "711": [
    "class Solution:",
    "",
    "    def numDistinctIslands2(self, grid):",
    "        (rows, cols) = (len(grid), len(grid[0]))",
    "        signatures = set()",
    "        for r in range(rows):",
    "            for c in range(cols):",
    "                if grid[r][c] == 0:",
    "                    continue",
    "                stack = [(r, c)]",
    "                grid[r][c] = 0",
    "                points = []",
    "                while stack:",
    "                    (x, y) = stack.pop()",
    "                    points.append((x, y))",
    "                    for (dr, dc) in ((1, 0), (-1, 0), (0, 1), (0, -1)):",
    "                        (nr, nc) = (x + dr, y + dc)",
    "                        if 0 <= nr < rows and 0 <= nc < cols and (grid[nr][nc] == 1):",
    "                            grid[nr][nc] = 0",
    "                            stack.append((nr, nc))",
    "                forms = []",
    "                for mode in range(8):",
    "                    shape = []",
    "                    for (x, y) in points:",
    "                        (a, b) = ((x, y), (x, -y), (-x, y), (-x, -y), (y, x), (y, -x), (-y, x), (-y, -x))[mode]",
    "                        shape.append((a, b))",
    "                    min_r = min((a for (a, b) in shape))",
    "                    min_c = min((b for (a, b) in shape))",
    "                    normalized = tuple(sorted(((a - min_r, b - min_c) for (a, b) in shape)))",
    "                    forms.append(normalized)",
    "                canonical = min(forms)",
    "                signatures.add(canonical)",
    "        return len(signatures)"
  ],
  "1559": [
    "class Solution:",
    "",
    "    def containsCycle(self, grid):",
    "        (rows, cols) = (len(grid), len(grid[0]))",
    "        seen = [[False] * cols for _ in range(rows)]",
    "        for r in range(rows):",
    "            for c in range(cols):",
    "                if seen[r][c]:",
    "                    continue",
    "                stack = [(r, c, -1, -1)]",
    "                seen[r][c] = True",
    "                while stack:",
    "                    (x, y, pr, pc) = stack.pop()",
    "                    for (dr, dc) in ((1, 0), (-1, 0), (0, 1), (0, -1)):",
    "                        (nr, nc) = (x + dr, y + dc)",
    "                        if nr < 0 or nr >= rows or nc < 0 or (nc >= cols) or (grid[nr][nc] != grid[x][y]):",
    "                            continue",
    "                        if (nr, nc) == (pr, pc):",
    "                            continue",
    "                        if seen[nr][nc]:",
    "                            return True",
    "                        seen[nr][nc] = True",
    "                        stack.append((nr, nc, x, y))",
    "        return False"
  ]
