"class Solution:\n    def minOperations(self, nums):\n        from heapq import heappush, heappop\n        n = len(nums)\n        if n < 3:\n            return -1\n\n        def prefix(values, side):\n            heap = []\n            cost = 0\n            costs, ends, levels = [], [], []\n            for i, value in enumerate(values):\n                transformed = value - i\n                heappush(heap, -transformed)\n                if -heap[0] > transformed:\n                    largest = -heappop(heap)\n                    cost += largest - transformed\n                    heappush(heap, -transformed)\n                costs.append(cost)\n                levels.append(-heap[0])\n                ends.append(-heap[0] + i)\n            return costs, ends, levels\n\n        phase = 'left'\n        left_cost, left_end, left_levels = prefix(nums, 'left')\n        phase = 'right'\n        back_cost, back_end, back_levels = prefix(nums[::-1], 'right')\n        right_cost = back_cost[::-1]\n        right_end = back_end[::-1]\n\n        phase = 'peaks'\n        best = float('inf')\n        best_peak = -1\n        for peak in range(1, n - 1):\n            left_part = left_cost[peak - 1]\n            right_part = right_cost[peak + 1]\n            required = max(left_end[peak - 1], right_end[peak + 1]) + 1\n            target_peak = max(nums[peak], required)\n            raise_cost = target_peak - nums[peak]\n            candidate = left_part + right_part + raise_cost\n            if candidate < best:\n                best = candidate\n                best_peak = peak\n\n        phase = 'build'\n        def recover(levels, length, side):\n            fitted = levels[:length]\n            for i in range(length - 2, -1, -1):\n                fitted[i] = min(fitted[i], fitted[i + 1])\n            values = []\n            for i, level in enumerate(fitted):\n                values.append(level + i)\n            return values\n\n        left = recover(left_levels, best_peak, 'left')\n        right = recover(back_levels, n - best_peak - 1, 'right')[::-1]\n        height = max(nums[best_peak], left[-1] + 1, right[0] + 1)\n        adjusted = left + [height] + right\n        changes = []\n        for index in range(n):\n            changes.append(adjusted[index] - nums[index])\n        return best\n"
